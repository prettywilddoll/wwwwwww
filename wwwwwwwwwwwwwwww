-- ===== ЛОГИКА SILENT AIM (без изменений) =====
local function getClosest()
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    local fovRadius = math.max(_G.FOV_RADIUS or 0, 1)
    local candidates = {}

    local myChar = LocalPlayer.Character

    for _, v in ipairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            local char = v.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local isKnocked = false
                if _G.KnockCheck then
                    if hum:GetState() == Enum.HumanoidStateType.Physics or hum:GetState() == Enum.HumanoidStateType.Ragdoll then
                        isKnocked = true
                    elseif hum.PlatformStand then
                        isKnocked = true
                    elseif hum:GetAttribute("Knocked") == true or char:GetAttribute("Knocked") == true then
                        isKnocked = true
                    end
                end

                if not isKnocked then
                    local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    if part then
                        local screenPos, onScreen = cam:WorldToScreenPoint(part.Position)
                        if onScreen then
                            local screenDistance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if screenDistance <= fovRadius then
                                local passesWallCheck = true
                                if _G.WallCheck then
                                    local origin = cam.CFrame.Position
                                    local dir = part.Position - origin
                                    local dist = dir.Magnitude
                                    if dist > 0 then
                                        local params = RaycastParams.new()
                                        params.FilterType = Enum.RaycastFilterType.Exclude
                                        params.FilterDescendantsInstances = { myChar, cam }
                                        local hit = workspace:Raycast(origin, dir.Unit * dist, params)
                                        if hit and hit.Instance and not hit.Instance:IsDescendantOf(char) then
                                            passesWallCheck = false
                                        end
                                    end
                                end

                                if passesWallCheck then
                                    table.insert(candidates, {
                                        part = part,
                                        distance = screenDistance
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    local best = nil
    local bestDistance = math.huge
    for _, candidate in ipairs(candidates) do
        if candidate.distance < bestDistance then
            bestDistance = candidate.distance
            best = candidate.part
        end
    end

    return best
end

local function setupSilentAim()
    local handler = nil
    local success, result = pcall(function()
        local mods = ReplicatedStorage:FindFirstChild("Modules")
        if not mods then return nil end
        local gh = mods:FindFirstChild("GunHandler")
        if not gh then return nil end
        return require(gh)
    end)

    if success and result then
        handler = result
        if handler and handler.getAim then
            local oldGetAim = handler.getAim
            handler.getAim = function(origin, maxDist)
                if not _G.SilentAim_Enabled or not _G.FOV_RADIUS or _G.FOV_RADIUS <= 0 then
                    return oldGetAim(origin, maxDist)
                end
                if _G.RevolverBypass then
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool and (tool.Name == "[Revolver]" or tool.Name == "Revolver") then
                        return oldGetAim(origin, maxDist)
                    end
                end
                local target = getClosest()
                if target and target.Parent then
                    if _G.KnockCheck then
                        local hum = target.Parent:FindFirstChildOfClass("Humanoid")
                        if hum and (hum.Health <= 0 or hum.PlatformStand or hum:GetState() == Enum.HumanoidStateType.Physics) then
                            return oldGetAim(origin, maxDist)
                        end
                    end
                    local dir = (target.Position - origin)
                    if dir.Magnitude > 0 then
                        return dir.Unit, math.min(dir.Magnitude, maxDist or 200)
                    end
                end
                return oldGetAim(origin, maxDist)
            end
            print("owwo@aim: Silent Aim успешно внедрён в GunHandler")
        else
            warn("owwo@aim: GunHandler найден, но getAim отсутствует")
        end
    else
        warn("owwo@aim: Не удалось найти GunHandler в ReplicatedStorage.Modules")
    end
end

task.spawn(setupSilentAim)

ReplicatedStorage.ChildAdded:Connect(function(child)
    if child.Name == "Modules" then
        task.wait(1)
        setupSilentAim()
    end
end)

-- ===== ЛОГИКА DELAY CHANGER =====
local function applyCustomDelay(v)
    if not _G.DelayChangerEnabled then return end
    if (v.Name == "ShootingCooldown" or v.Name == "ToleranceCooldown") and v:IsA("ValueBase") then
        local tool = v:FindFirstAncestorOfClass("Tool")
        local delayValue = _G.DelayChangerOthers
        if tool then
            if tool.Name == "[Revolver]" then delayValue = _G.DelayChangerRevolver
            elseif tool.Name == "[Double-Barrel SG]" then delayValue = _G.DelayChangerDoubleBarrel
            elseif tool.Name == "[TacticalShotgun]" then delayValue = _G.DelayChangerTacticalShotgun end
        end
        v.Value = delayValue
        v:GetPropertyChangedSignal("Value"):Connect(function()
            if v.Value ~= delayValue then v.Value = delayValue end
        end)
    end
end

for _, v in ipairs(game:GetDescendants()) do applyCustomDelay(v) end
game.DescendantAdded:Connect(function(v) applyCustomDelay(v) end)

