-- Скрипт-менеджер для инжектора (выбор между HC и Silent)

local hcScript = [[
--[[ КОД СКРИПТА HC (local UIS) — полностью скопирован из вашего файла ]]--
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")
