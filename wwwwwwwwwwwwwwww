    titleL.Position = UDim2.fromOffset(12, 7)
    titleL.Size = UDim2.new(1, -24, 0, 14)
    titleL.ZIndex = 13
    titleL.Parent = card

    local cur = get()
    local valL = Instance.new("TextLabel")
    valL.BackgroundTransparency = 1
    valL.Text = isFloat and string.format("%.1f", cur) or tostring(cur)
    valL.TextColor3 = ACCENT
