            btn.Font = Enum.Font.GothamSemibold
            btn.TextSize = 12
            btn.Parent = TargetListFrame
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 4)
            corner.Parent = btn
