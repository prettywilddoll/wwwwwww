--=====================
--
--          Silent Aim Hook
--
--=====================
local mt = getrawmetatable(game)
local oldnamecall = mt.__namecall
local oldindex = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if not checkcaller() and cfg.Enabled and CachedPart then
        if self == workspace and method == "Raycast" then
            local targetPos = ResolvedPosition or (CachedPart.Position + (CachedPart.Velocity * cfg.Prediction))
            return {
                Position = targetPos,
                Instance = CachedPart,
                Material = Enum.Material.Plastic,
                Normal = Vector3.new(0, 1, 0)
            }
        end
    end
    return oldnamecall(self, ...)
end)

mt.__index = newcclosure(function(self, key)
    if not checkcaller() and cfg.Enabled and CachedPart and self == Mouse then
        if key == "Hit" or key == "Target" then
            local targetPos = ResolvedPosition or (CachedPart.Position + (CachedPart.Velocity * cfg.Prediction))
            if key == "Hit" then
                return CFrame.new(targetPos)
            else
                return CachedPart
            end
        end
    end
    return oldindex(self, key)
end)

setreadonly(mt, true)

