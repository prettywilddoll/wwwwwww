-- Toggle
local function CreateToggle(parent, text, defaultState, callback)
    local Row = Instance.new("Frame", parent)
    Row.Size = UDim2.new(1, 0, 0, ElementHeight)
    Row.BackgroundTransparency = 1

    local BoxSize = IsMobile and 24 or 12
    local Box = Instance.new("TextButton", Row)
    Box.Size = UDim2.new(0, BoxSize, 0, BoxSize)
    Box.Position = UDim2.new(0, 0, 0.5, -BoxSize/2)
    Box.BackgroundColor3 = defaultState and Theme.AccentColor or Theme.ButtonBg
    Box.BorderColor3 = defaultState and Theme.AccentColor or Theme.BorderColor
    Box.BorderSizePixel = 1
    Box.Text = ""

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size = UDim2.new(1, -(BoxSize + 8), 1, 0)
    Lbl.Position = UDim2.new(0, BoxSize + 8, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = text
    Lbl.TextColor3 = defaultState and Theme.TextColor or Theme.DimTextColor
    Lbl.TextSize = FontSize
    Lbl.Font = Enum.Font.RobotoMono
    Lbl.TextXAlignment = Enum.TextXAlignment.Left

    local state = defaultState
    local function updateState(newState)
        state = newState
        Box.BackgroundColor3 = state and Theme.AccentColor or Theme.ButtonBg
        Box.BorderColor3 = state and Theme.AccentColor or Theme.BorderColor
        Lbl.TextColor3 = state and Theme.TextColor or Theme.DimTextColor
    end

    Box.MouseButton1Click:Connect(function()
        updateState(not state)
        callback(state)
    end)

    return updateState
end

-- Slider
local function CreateSlider(parent, name, minVal, maxVal, get, set, isFloat)
    local Row = Instance.new("Frame", parent)
    Row.Size = UDim2.new(1, 0, 0, ElementHeight + (IsMobile and 10 or 0))  -- чуть выше для слайдера
    Row.BackgroundTransparency = 1

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size = UDim2.new(1, -70, 0, ElementHeight * 0.6)
    Lbl.BackgroundTransparency = 1
    local currentVal = get()
    Lbl.Text = name .. ": " .. (isFloat and string.format("%.3f", currentVal) or tostring(math.floor(currentVal + 0.5)))
    Lbl.TextColor3 = Theme.DimTextColor
    Lbl.TextSize = FontSize
    Lbl.Font = Enum.Font.RobotoMono
    Lbl.TextXAlignment = Enum.TextXAlignment.Left

    local InputBox = Instance.new("TextBox", Row)
    local BoxWidth = IsMobile and 60 or 45
    InputBox.Size = UDim2.new(0, BoxWidth, 0, ElementHeight * 0.7)
    InputBox.Position = UDim2.new(1, -BoxWidth, 0, 0)
    InputBox.BackgroundColor3 = Theme.ButtonBg
    InputBox.BorderColor3 = Theme.BorderColor
    InputBox.Text = isFloat and string.format("%.3f", currentVal) or tostring(math.floor(currentVal + 0.5))
    InputBox.TextColor3 = Theme.TextColor
    InputBox.Font = Enum.Font.RobotoMono
    InputBox.TextSize = FontSize
    InputBox.TextXAlignment = Enum.TextXAlignment.Center

    local Track = Instance.new("Frame", Row)
    Track.Size = UDim2.new(1, 0, 0, SliderHeight)
    Track.Position = UDim2.new(0, 0, 0, ElementHeight * 0.75)
    Track.BackgroundColor3 = Theme.DarkBg
    Track.BorderColor3 = Theme.BorderColor
    Track.BorderSizePixel = 1

    local TrackCorner = Instance.new("UICorner", Track)
    TrackCorner.CornerRadius = UDim.new(0, 2)

    local Fill = Instance.new("Frame", Track)
    local startPct = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
    Fill.Size = UDim2.new(startPct, 0, 1, 0)
    Fill.BackgroundColor3 = Theme.AccentColor
    Fill.BorderSizePixel = 0

    local FillCorner = Instance.new("UICorner", Fill)
    FillCorner.CornerRadius = UDim.new(0, 2)

    local DragBtn = Instance.new("TextButton", Track)
    local DragSize = IsMobile and 12 or 6
    DragBtn.Size = UDim2.new(0, DragSize, 0, DragSize + 4)
    DragBtn.Position = UDim2.new(startPct, -DragSize/2, 0.5, -(DragSize+4)/2)
    DragBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    DragBtn.BorderColor3 = Theme.AccentColor
    DragBtn.BorderSizePixel = 1
    DragBtn.Text = ""

    local function updateVisual(val)
        val = math.clamp(val, minVal, maxVal)
        if not isFloat then val = math.floor(val + 0.5) end
        local pct = (val - minVal) / (maxVal - minVal)
        Fill.Size = UDim2.new(pct, 0, 1, 0)
        DragBtn.Position = UDim2.new(pct, -DragSize/2, 0.5, -(DragSize+4)/2)
        local display = isFloat and string.format("%.3f", val) or tostring(math.floor(val + 0.5))
        Lbl.Text = name .. ": " .. display
        InputBox.Text = display
        set(val)
    end

    local sliding = false
    local function updateFromInput(input)
        local abs = Track.AbsoluteSize.X
        if abs < 1 then return end
        local p = math.clamp((input.Position.X - Track.AbsolutePosition.X) / abs, 0, 1)
        local val = minVal + p * (maxVal - minVal)
        updateVisual(val)
    end

    DragBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
        end
    end)
    Track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            updateFromInput(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(i)
        end
    end)

    InputBox.FocusLost:Connect(function()
        local val = tonumber(InputBox.Text)
        if val then updateVisual(val) else updateVisual(get()) end
    end)
    InputBox.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Return then
            local val = tonumber(InputBox.Text)
            if val then updateVisual(val) else updateVisual(get()) end
        end
    end)
end

-- Keybind (для мобильных заменён на Toggle "Speed Active")
local keybindListeners = {}
local function CreateKeybind(parent, text, currentKey, callback)
    if IsMobile then
        -- На мобильных вместо привязки клавиши создаём переключатель для SpeedActive
        local function dummy(v)
            _G.SpeedActive = v
            -- Можно также обновить callback, если нужен
        end
        return CreateToggle(parent, "Speed Active", _G.SpeedActive, function(v)
            _G.SpeedActive = v
        end)
    else
        local Row = Instance.new("Frame", parent)
        Row.Size = UDim2.new(1, 0, 0, ElementHeight)
        Row.BackgroundTransparency = 1

        local Lbl = Instance.new("TextLabel", Row)
        Lbl.Size = UDim2.new(0.6, 0, 1, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = text
        Lbl.TextColor3 = Theme.DimTextColor
        Lbl.Font = Enum.Font.RobotoMono
        Lbl.TextSize = FontSize
        Lbl.TextXAlignment = Enum.TextXAlignment.Left

        local BBtn = Instance.new("TextButton", Row)
        BBtn.Size = UDim2.new(0.4, 0, 1, 0)
        BBtn.Position = UDim2.new(0.6, 0, 0, 0)
        BBtn.BackgroundColor3 = Theme.ButtonBg
        BBtn.BorderColor3 = Theme.BorderColor
        BBtn.Text = "[" .. currentKey.Name .. "]"
        BBtn.TextColor3 = Theme.DimColor
        BBtn.Font = Enum.Font.RobotoMono
        BBtn.TextSize = FontSize

        local listenerState = { listening = false, button = BBtn, callback = callback }
        BBtn.MouseButton1Click:Connect(function()
            for _, state in ipairs(keybindListeners) do state.listening = false end
            listenerState.listening = true
            BBtn.Text = "..."
        end)

        table.insert(keybindListeners, listenerState)
        if #keybindListeners == 1 then
            UIS.InputBegan:Connect(function(io)
                if io.UserInputType ~= Enum.UserInputType.Keyboard then return end
                for _, state in ipairs(keybindListeners) do
                    if state.listening then
                        state.listening = false
                        state.button.Text = "[" .. io.KeyCode.Name .. "]"
                        state.callback(io.KeyCode)
                        break
                    end
                end
            end)
        end
    end
end

