-- Toggle (как в pwd char)
local function CreateToggle(parent, text, defaultState, callback)
    local Row = Instance.new("Frame", parent)
    Row.Size = UDim2.new(1, 0, 0, 18)
    Row.BackgroundTransparency = 1

    local Box = Instance.new("TextButton", Row)
    Box.Size = UDim2.new(0, 12, 0, 12)
    Box.Position = UDim2.new(0, 0, 0.5, -6)
    Box.BackgroundColor3 = defaultState and Theme.AccentColor or Theme.ButtonBg
    Box.BorderColor3 = defaultState and Theme.AccentColor or Theme.BorderColor
    Box.BorderSizePixel = 1
    Box.Text = ""

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size = UDim2.new(1, -22, 1, 0)
    Lbl.Position = UDim2.new(0, 22, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = text
    Lbl.TextColor3 = defaultState and Theme.TextColor or Theme.DimTextColor
    Lbl.TextSize = 11
    Lbl.Font = Enum.Font.RobotoMono
    Lbl.TextXAlignment = Enum.TextXAlignment.Left

    local state = defaultState
    local function updateState(newState)
        state = newState
        Box.BackgroundColor3 = state and Theme.AccentColor or Theme.ButtonBg
        Box.BorderColor3 = state and Theme.AccentColor or Theme.BorderColor
        Lbl.TextColor3 = state and Theme.TextColor or Theme.DimTextColor
    end

    Box.MouseButton1Click:Connect(function()
        updateState(not state)
        callback(state)
    end)

    return updateState
end

-- Slider (стилизованный под общую тему)
local function CreateSlider(parent, name, minVal, maxVal, get, set, isFloat)
    local Row = Instance.new("Frame", parent)
    Row.Size = UDim2.new(1, 0, 0, 44)
    Row.BackgroundTransparency = 1

    local Title = Instance.new("TextLabel", Row)
    Title.Size = UDim2.new(1, 0, 0, 14)
    Title.BackgroundTransparency = 1
    Title.Text = name
    Title.TextColor3 = Theme.DimTextColor
    Title.TextSize = 11
    Title.Font = Enum.Font.RobotoMono
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local ValueLabel = Instance.new("TextLabel", Row)
    ValueLabel.Size = UDim2.new(0, 50, 0, 14)
    ValueLabel.Position = UDim2.new(1, -50, 0, 0)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = tostring(get())
    ValueLabel.TextColor3 = Theme.AccentColor
    ValueLabel.TextSize = 11
    ValueLabel.Font = Enum.Font.RobotoMono
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local Track = Instance.new("Frame", Row)
    Track.Size = UDim2.new(1, 0, 0, 6)
    Track.Position = UDim2.new(0, 0, 0, 20)
    Track.BackgroundColor3 = Theme.DarkBg
    Track.BorderColor3 = Theme.BorderColor
    Track.BorderSizePixel = 1

    local TrackCorner = Instance.new("UICorner", Track)
    TrackCorner.CornerRadius = UDim.new(0, 3)

    local Fill = Instance.new("Frame", Track)
    Fill.Size = UDim2.new(0, 0, 1, 0)
    Fill.BackgroundColor3 = Theme.AccentColor
    Fill.BorderSizePixel = 0

    local FillCorner = Instance.new("UICorner", Fill)
    FillCorner.CornerRadius = UDim.new(0, 3)

    local Knob = Instance.new("TextButton", Track)
    Knob.Size = UDim2.new(0, 14, 0, 14)
    Knob.Position = UDim2.new(0, -7, 0.5, -7)
    Knob.BackgroundColor3 = Theme.AccentColor
    Knob.BorderSizePixel = 0
    Knob.Text = ""

    local KnobCorner = Instance.new("UICorner", Knob)
    KnobCorner.CornerRadius = UDim.new(0, 7)

    local currentVal = get()
    local function updateVisual(val, instant)
        local p = math.clamp((val - minVal) / (maxVal - minVal), 0, 1)
        local fillSize = UDim2.new(p, 0, 1, 0)
        local knobPos = UDim2.new(p, -7, 0.5, -7)
        if instant then
            Fill.Size = fillSize
            Knob.Position = knobPos
        else
            TweenService:Create(Fill, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {Size = fillSize}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {Position = knobPos}):Play()
        end
        ValueLabel.Text = isFloat and string.format("%.1f", val) or tostring(math.floor(val + 0.5))
    end
    updateVisual(currentVal, true)

    local sliding = false
    local function updateFromInput(input)
        local abs = Track.AbsoluteSize.X
        if abs < 1 then return end
        local p = math.clamp((input.Position.X - Track.AbsolutePosition.X) / abs, 0, 1)
        local val = minVal + p * (maxVal - minVal)
        if not isFloat then val = math.floor(val + 0.5) end
        set(val)
        updateVisual(val, false)
    end

    Knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end
    end)
    Track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            updateFromInput(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then updateFromInput(i) end
    end)
end

