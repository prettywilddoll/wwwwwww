    valL.Position = UDim2.fromOffset(12, 24)
    valL.Size = UDim2.new(1, -24, 0, 14)
    valL.ZIndex = 13
    valL.Parent = card

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -24, 0, 6)
    track.Position = UDim2.fromOffset(12, 44)
    track.BackgroundColor3 = CARD2
    track.BorderSizePixel = 0
    track.ZIndex = 13
    track.Parent = card

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(0, 3)
    trackCorner.Parent = track

    local pct = math.clamp((cur - minV) / (maxV - minV), 0, 1)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel = 0
    fill.ZIndex = 13
    fill.Parent = track

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 3)
    fillCorner.Parent = fill

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = UDim2.new(pct, 0, 0.5, 0)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = WHITE
    knob.Text = ""
    knob.ZIndex = 14
    knob.Parent = track

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(0, 8)
    knobCorner.Parent = knob

    local knobShadow = Instance.new("UIStroke")
    knobShadow.Color = SHADOW
    knobShadow.Transparency = 0.5
    knobShadow.Thickness = 1
    knobShadow.Parent = knob

    local knobGlow = Instance.new("UIStroke")
    knobGlow.Color = ACCENT
    knobGlow.Transparency = 0.6
    knobGlow.Thickness = 2
    knobGlow.Parent = knob

    -- Hover для knob
    knob.MouseEnter:Connect(function()
        TweenService:Create(knob, TweenInfo.new(0.15), {Size = UDim2.fromOffset(18, 18)}):Play()
    end)
    knob.MouseLeave:Connect(function()
        TweenService:Create(knob, TweenInfo.new(0.15), {Size = UDim2.fromOffset(16, 16)}):Play()
    end)

    local function setVisual(v, instant)
        local p = math.clamp((v - minV) / (maxV - minV), 0, 1)
        local targetFillSize = UDim2.new(p, 0, 1, 0)
        local targetKnobPos = UDim2.new(p, 0, 0.5, 0)
        valL.Text = isFloat and string.format("%.1f", v) or tostring(v)

        if instant then
            fill.Size = targetFillSize
            knob.Position = targetKnobPos
        else
            TweenService:Create(fill, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {Size = targetFillSize}):Play()
            TweenService:Create(knob, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {Position = targetKnobPos}):Play()
        end
    end

    local sliding = false
    local function update(input)
        local abs = track.AbsoluteSize.X
        if abs < 1 then return end
        local p = math.clamp((input.Position.X - track.AbsolutePosition.X) / abs, 0, 1)
        local v = minV + p * (maxV - minV)
        if not isFloat then v = math.floor(v + 0.5) end
        setVisual(v, false)
        set(v)
    end

    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end
    end)
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            update(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then update(i) end
    end)
  
    setVisual(cur, true)
end

